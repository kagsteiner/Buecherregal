{
  "name": "buecherregal",
  "version": "0.1.0",
  "private": true,
  "description": "Virtuelles Bücherregal mit lokalem Kindle-Import",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "check": "tsc --noEmit",
    "start": "node src/server.js",
    "db:init": "node src/cli.js init",
    "kindle:import": "node src/cli.js import-kindle",
    "metadata:pages": "node src/cli.js enrich-pages",
    "metadata:colors": "node src/cli.js enrich-colors",
    "metadata:covers": "node src/cli.js enrich-covers",
    "metadata:typography": "node src/cli.js enrich-typography",
    "books:list": "node src/cli.js list",
    "test": "node --test && npm run check && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource-variable/cormorant-garamond": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/libre-baskerville": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/orbitron": "^5.3.0",
    "@fontsource-variable/oswald": "^5.3.0",
    "@fontsource-variable/roboto-slab": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "@fontsource/special-elite": "^5.3.0",
    "@napi-rs/canvas": "^1.0.7",
    "bplist-parser": "^0.3.2",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
